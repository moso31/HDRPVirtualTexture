#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.high-definition/Runtime/ShaderLibrary/ShaderVariables.hlsl"

#pragma only_renderers d3d11 playstation xboxone xboxseries vulkan metal switch

#pragma kernel KMain

// 纹理，xy = sector的坐标；z = 虚拟纹理信息（12bit X + 12bit Y + 8bit Size, for indirect Texture）
RW_TEXTURE2D(uint1, _sector2VirtualImageInfoTexture);
StructuredBuffer<uint3> _write2AtlasBuffer; // 一个一维数组；xy = 一个当前帧依赖的sector的位置；z = 对应的虚拟纹理（12bit X + 12bit Y + 8bit Size）
uint _write2AtlasCount;


// 首先这个纹理是sector2VirtualImage转换纹理，大小为32x32的uint。
// 这里CS的作用：xy为32x32中的坐标；z为对应的虚拟纹理（12bit X + 12bit Y + 8bit Size）
[numthreads(16,1,1)]
void KMain(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (dispatchThreadId.x >= _write2AtlasCount) return;
    
    // 相当于遍历每个sector2Atlas
    uint3 sector2Atlas = _write2AtlasBuffer[dispatchThreadId.x]; 
    
    // 将每个sector依赖的数据，写到对应的位置上
    _sector2VirtualImageInfoTexture[sector2Atlas.xy] = sector2Atlas.z;
}
